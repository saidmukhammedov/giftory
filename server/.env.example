PORT=5000
# Neon: Dashboard > Connect > pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/giftory?sslmode=verify-full
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Telegram login (BotFather > your bot > Login Widget). Leave empty to hide the button.
PUBLIC_URL=http://localhost:5173
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Self-hosted Umami (optional). Leave empty to turn analytics off.
UMAMI_URL=
