{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix client && npm ci --prefix server --omit=dev",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "giftory-app.vercel.app"
        }
      ],
      "destination": "https://giftory.uz/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/schema.sql",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/u/(.*)",
      "destination": "/api"
    },
    {
      "source": "/w/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|facebookexternalhit|Twitterbot|WhatsApp|Slackbot|LinkedInBot|Discordbot|vkShare|SkypeUriPreview|Googlebot|bingbot|YandexBot|Applebot|Pinterest).*"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/bot/cron",
      "schedule": "0 4 * * *"
    }
  ]
}
